<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    x:Class="Project_SDOBA.Views.CreateConversationPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="NEW CONVERSATION"
    Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="Auto,Auto,*,Auto">

        <HorizontalStackLayout
            Grid.Row="0"
            Padding="20"
            Spacing="10">

            <Button
                Text="BACK"
                FontFamily="ShareTechMono"
                Clicked="OnBackClicked" />

            <Label
                Text="NEW CONVERSATION"
                FontFamily="ShareTechMono"
                FontSize="20"
                VerticalOptions="Center" />

        </HorizontalStackLayout>

        <VerticalStackLayout
            Grid.Row="1"
            Padding="20,0,20,15"
            Spacing="10">

            <Label
                Text="ADD USERS"
                FontFamily="ShareTechMono"
                FontSize="16" />

            <Entry
                x:Name="UsernameEntry"
                Placeholder="USERNAME"
                FontFamily="ShareTechMono"
                ReturnType="Search"
                TextChanged="OnUsernameTextChanged" />

            <Border
                x:Name="UserResult"
                IsVisible="False"
                Padding="12">

                <VerticalStackLayout>

                    <Label
                        x:Name="FoundUsernameLabel"
                        FontFamily="ShareTechMono"
                        FontSize="17" />

                    <Label
                        x:Name="FoundUserIdLabel"
                        FontFamily="ShareTechMono"
                        FontSize="12" />

                </VerticalStackLayout>

                <Border.GestureRecognizers>
                    <TapGestureRecognizer
                        Tapped="OnFoundUserTapped" />
                </Border.GestureRecognizers>

            </Border>

            <Label
                x:Name="ErrorLabel"
                IsVisible="False"
                FontFamily="ShareTechMono"
                FontSize="13" />

        </VerticalStackLayout>

        <CollectionView
            x:Name="MembersList"
            Grid.Row="2"
            Margin="20,0">

            <CollectionView.EmptyView>
                <Label
                    Text="NO ADDITIONAL MEMBERS"
                    FontFamily="ShareTechMono"
                    FontSize="16"
                    HorizontalOptions="Center"
                    VerticalOptions="Center" />
            </CollectionView.EmptyView>

            <CollectionView.ItemTemplate>
                <DataTemplate>

                    <Border
                        Padding="12"
                        Margin="0,0,0,10">

                        <Grid ColumnDefinitions="*,Auto">

                            <VerticalStackLayout>

                                <Label
                                    Text="{Binding Username, StringFormat='@{0}'}"
                                    FontFamily="ShareTechMono"
                                    FontSize="17" />

                                <Label
                                    Text="{Binding Id, StringFormat='ID: {0}'}"
                                    FontFamily="ShareTechMono"
                                    FontSize="12" />

                            </VerticalStackLayout>

                            <Button
                                Grid.Column="1"
                                Text="REMOVE"
                                FontFamily="ShareTechMono"
                                Clicked="OnRemoveMemberClicked"
                                CommandParameter="{Binding}" />

                        </Grid>

                    </Border>

                </DataTemplate>
            </CollectionView.ItemTemplate>

        </CollectionView>

        <Grid
            Grid.Row="3"
            Padding="15"
            ColumnDefinitions="*,Auto"
            ColumnSpacing="10">

            <Label
                x:Name="MembersCountLabel"
                Grid.Column="0"
                Text="MEMBERS: 1"
                FontFamily="ShareTechMono"
                FontSize="15"
                VerticalOptions="Center" />

            <Button
                Grid.Column="1"
                Text="CREATE"
                FontFamily="ShareTechMono"
                Clicked="OnCreateClicked" />

        </Grid>

    </Grid>

</ContentPage>